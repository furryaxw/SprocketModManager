{
  "$schema": "../../schemas/sprocket-mod.schema.json",
  "schema_version": 2,
  "id": "bbepis.xunity-auto-translator-melonmod-il2cpp",
  "name": "XUnity.AutoTranslator-MelonMod-IL2CPP",
  "authors": ["bbepis"],
  "repository": "bbepis/XUnity.AutoTranslator",
  "license": "MIT",
  "display_name": {
    "en": "XUnity AutoTranslator (MelonMod IL2CPP)",
    "zh": "XUnity 自动翻译器（MelonMod IL2CPP）"
  },
  "description": {
    "en": "Runtime translation framework for MelonLoader IL2CPP games.",
    "zh": "适用于 MelonLoader IL2CPP 游戏的运行时翻译框架。"
  },
  "release": {
    "include_prerelease": false,
    "version_pattern": "^v?([0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)$",
    "assets": {
      "include": ["XUnity.AutoTranslator-MelonMod-IL2CPP-*.zip"],
      "exclude": []
    }
  },
  "dependencies": [],
  "recommendations": ["furryaxw.xunity-il2cpptmpro-bridge"],
  "featured": false,
  "kind": "translateloader",
  "supply": {
    "xunity:translation": "{Sprocket}/AutoTranslator"
  },
  "install": {
    "payload": [
      {
        "match": "**",
        "target": "{Sprocket}",
        "layout": "tree"
      }
    ],
    "exclude": ["Mods/README (AutoTranslator).md"]
  },
  "category": "utility",
  "tags": ["translation", "localization", "xunity", "textmeshpro"]
}

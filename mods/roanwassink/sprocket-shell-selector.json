{
  "$schema": "../../schemas/sprocket-mod.schema.json",
  "schema_version": 3,
  "id": "roanwassink.sprocket-shell-selector",
  "name": "SprocketShellSelector",
  "authors": ["RoanWassink"],
  "repository": "RoanWassink/SprocketShellSelector",
  "license": "MIT",
  "display_name": {
    "en": "Sprocket Shell Selector",
    "zh": "Sprocket 弹种选择器"
  },
  "description": {
    "en": "Adds APFSDS long and short rod, APHE, HE, HEAT, HESH and sight- or keyboard-guided ATGM profiles to cannons, with calibre-scaled penetration, spall and spaced-armour loss. Profiles live in JSON and an armour simulator tests any of them without firing.",
    "zh": "为火炮加入 APFSDS 长/短杆、APHE、HE、HEAT、HESH 以及瞄准制导或键盘制导的 ATGM 弹种方案，穿深、破片与间隙装甲衰减都随口径缩放。弹种方案写在 JSON 里，另有装甲模拟器可在不开火的情况下试算。"
  },
  "release": {
    "include_prerelease": false,
    "version_pattern": "^v?([0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)$",
    "assets": {
      "include": ["SprocketShellSelector.dll"],
      "exclude": []
    }
  },
  "dependencies": [
    {
      "id": "bepinex.bepinex-be",
      "version": "*",
      "when": "*"
    },
    {
      "id": "hans21223.sprocket-mod-loader",
      "version": "*",
      "when": "*"
    }
  ],
  "recommendations": [],
  "featured": false,
  "install": {
    "files": [
      {
        "match": "*.dll",
        "type": "bepinex:plugin"
      }
    ],
    "scan_dlls": false,
    "exclude": []
  },
  "category": "gameplay",
  "tags": ["shells", "ammunition", "ballistics", "atgm", "bepinex"]
}

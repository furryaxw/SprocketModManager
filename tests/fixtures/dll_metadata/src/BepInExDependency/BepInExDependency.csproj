  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BepInExDependency</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>

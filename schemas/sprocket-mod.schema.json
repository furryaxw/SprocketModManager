{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprocketmods.furryaxw.top/schemas/sprocket-mod.schema.json",
  "title": "SprocketModManager Registry Entry",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "install"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 3 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "display_name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "release": { "$ref": "#/$defs/release" },
    "releases": {
      "type": "array",
      "items": { "$ref": "#/$defs/releaseRecord" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "recommendations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      }
    },
    "featured": { "type": "boolean" },
    "kind": {
      "description": "modfile installs through install.files; the four loader kinds may install through install.payload, or through install.files when their content maps onto supply types. Only modloader is listed on the loader page and may declare an external release source.",
      "enum": ["modfile", "modloader", "loaderbridge", "translateloader", "patch"],
      "default": "modfile"
    },
    "provides": { "$ref": "#/$defs/provides" },
    "supply": { "$ref": "#/$defs/supply" },
    "install": { "$ref": "#/$defs/install" },
    "category": {
      "enum": ["gameplay", "utility", "library", "visual", "audio", "translation", "other"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["release"],
        "properties": {
          "release": {
            "required": ["source"],
            "properties": {
              "source": {
                "required": ["type"],
                "properties": { "type": { "const": "external" } }
              }
            }
          }
        }
      },
      "then": {
        "required": ["kind"],
        "properties": { "kind": { "const": "modloader" } }
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["modloader", "loaderbridge", "translateloader", "patch"] }
        }
      },
      "then": {
        "properties": {
          "install": {
            "anyOf": [{ "required": ["files"] }, { "required": ["payload"] }]
          }
        }
      },
      "else": {
        "properties": {
          "install": { "not": { "required": ["payload"] } }
        }
      }
    }
  ],
  "$defs": {
    "localized": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[xX](?:-[A-Za-z0-9]{1,8})+)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "release": {
      "type": "object",
      "required": ["version_pattern", "assets"],
      "properties": {
        "include_prerelease": { "type": "boolean" },
        "version_pattern": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "object",
          "required": ["include"],
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "source": { "$ref": "#/$defs/releaseSource" }
      }
    },
    "releaseSource": {
      "description": "Where the binaries come from. `github` reads the package's own GitHub Releases; `external` reads an allowlisted HTTPS host and requires the entry to carry its `releases`.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["github", "external"] },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "external" } } },
          "then": { "required": ["hosts"] }
        }
      ]
    },
    "releaseRecord": {
      "description": "One release the entry carries itself, used when release.source is external. `assets` is the download set; `dependencies` and `compatibility` are written by the index build from the release body's sp-compat block.",
      "type": "object",
      "required": ["id", "version", "assets"],
      "properties": {
        "id": { "type": "integer" },
        "tag": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "prerelease": { "type": "boolean" },
        "published_at": { "type": "string" },
        "page_url": { "type": "string" },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseAsset" }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "source": { "enum": ["declared", "inherited"] },
            "from_tag": { "type": "string" },
            "warnings": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "releaseAsset": {
      "description": "One downloadable file of a carried release. `digest` is the publisher SHA-256 (`sha256:<hex>`), or null when the publisher gives none.",
      "type": "object",
      "required": ["id", "download_url"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer" },
        "download_url": { "type": "string", "minLength": 1 },
        "digest": { "type": ["string", "null"] },
        "updated_at": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["id", "version", "when"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "version": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 }
      }
    },
    "provides": {
      "description": "Capabilities this package supplies: capability id -> version. `{version}` means this release's own version. Absent means the package supplies its own package id.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "supply": {
      "description": "Loader type table: installable file type -> directory under the game root. Keys are concrete types; a loader's own payload is the install.payload line.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/concrete_file_type" },
      "additionalProperties": { "$ref": "#/$defs/supply_target" }
    },
    "file_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*:(?:[a-z0-9]+(?:[.-][a-z0-9]+)*|\\*)$"
    },
    "concrete_file_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*:[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "supply_target": {
      "type": "string",
      "pattern": "^\\{Sprocket\\}(?:/[A-Za-z0-9._-]+)*$"
    },
    "install": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["standard", "patch"] },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileRule" }
        },
        "payload": {
          "type": "array",
          "items": { "$ref": "#/$defs/payloadRule" }
        },
        "replace": {
          "description": "Types this patch takes over whole: the provider's directory is backed up and cleared, then the package's files land in it; uninstall restores the directory.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/concrete_file_type" }
        },
        "scan_dlls": { "type": "boolean" },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        { "not": { "required": ["files", "payload"] } },
        {
          "if": { "required": ["replace"] },
          "then": {
            "required": ["mode"],
            "properties": { "mode": { "const": "patch" } }
          }
        }
      ]
    },
    "fileRule": {
      "type": "object",
      "required": ["match", "type"],
      "properties": {
        "match": { "type": "string", "minLength": 1 },
        "type": {
          "description": "A concrete type, or `<loader>:*` to let the DLL's PE metadata decide the concrete kind.",
          "$ref": "#/$defs/file_type"
        },
        "subpath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "layout": { "enum": ["file", "tree"] },
        "when": {
          "description": "Range over the package's own versions this rule applies to; omitted means every version.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payloadRule": {
      "type": "object",
      "required": ["match", "target"],
      "properties": {
        "match": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/supply_target" },
        "subpath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "layout": { "enum": ["file", "tree"] },
        "when": {
          "description": "Range over the package's own versions this rule applies to; omitted means every version.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

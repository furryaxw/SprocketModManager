{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprocketmods.furryaxw.top/schemas/sprocket-mod.schema.json",
  "title": "Sprocket Mod Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "authors",
    "repository",
    "license",
    "display_name",
    "release",
    "dependencies",
    "install",
    "category",
    "tags"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "display_name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "release": { "$ref": "#/$defs/release" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "recommendations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      }
    },
    "featured": { "type": "boolean" },
    "install": { "$ref": "#/$defs/install" },
    "category": {
      "enum": ["gameplay", "utility", "library", "visual", "audio", "translation", "other"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[xX](?:-[A-Za-z0-9]{1,8})+)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_prerelease", "version_pattern", "assets"],
      "properties": {
        "include_prerelease": { "type": "boolean" },
        "version_pattern": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude"],
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "when"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "version": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_dlls", "exclude", "overrides"],
      "properties": {
        "mode": { "enum": ["standard", "xunity-translation"] },
        "scan_dlls": { "type": "boolean" },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match", "target"],
            "properties": {
              "match": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
